  <string name="app_notifs_disabled_b" formatted="false">啟用應用程式通知</string>
  <string name="app_notifs_disabled_summary" formatted="false">您已停用此應用程式的所有通知。  請允許他們存取這些設定。</string>
  <string name="main_notifs_disabled_b" formatted="false">啟用主通知</string>
  <string name="main_notifs_disabled_summary" formatted="false">您已停用此應用程式的主要通知。  請啟用它以存取這些設定。</string>
  <string name="app_notifs_alarms_disabled_summary" formatted="false">您已停用此應用程式的所有通知。  請允許他們存取您的警報。</string>
  <string name="alarm_notifs_disabled_b" formatted="false">啟用警報</string>
  <string name="alarm_notifs_disabled_summary" formatted="false">您已停用此應用的鬧鐘通知群組。請啟用它以存取您的鬧鐘。</string>

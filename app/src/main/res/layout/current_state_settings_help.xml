<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/named_so_scroll_position_is_preserved"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent">

    <LinearLayout
        style="@style/help_ll"
        android:orientation="vertical">

        <View style="@style/help_cat_pre_margin" />

        <TextView
            style="@style/help_cat"
            android:text="@string/tab_current_info" />

        <TextView
            style="@style/help_text"
            android:text="@string/current_state_settings_help" />

        <View style="@style/help_cat_pre_margin" />

        <TextView
            style="@style/help_cat"
            android:text="@string/pref_cat_battery_current_main" />

        <View style="@style/help_cat_post_margin" />

        <TextView
            style="@style/help_pref"
            android:text="@string/pref_enable_battery_current" />

        <TextView
            style="@style/help_text"
            android:text="@string/pref_enable_battery_current_help" />

        <TextView
            style="@style/help_pref"
            android:text="@string/pref_battery_current_multiplier" />

        <TextView
            style="@style/help_text"
            android:text="@string/pref_battery_current_multiplier_help" />

        <TextView
            style="@style/help_pref"
            android:text="@string/pref_prefer_average_battery_current" />

        <TextView
            style="@style/help_text"
            android:text="@string/pref_prefer_current_avg_help" />

        <TextView
            style="@style/help_pref"
            android:text="@string/pref_battery_current_refresh_interval" />

        <TextView
            style="@style/help_text"
            android:text="@string/pref_battery_current_refresh_interval_help" />

    </LinearLayout>
</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="@dimen/widget_margin"
    tools:ignore="SpUsage">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/full_widget_rounded_rectangle"
        android:orientation="horizontal"
        tools:ignore="UselessParent">

        <!-- The small RemoteViews preview distributes width and height on separate axes. -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.3"
            android:background="@drawable/full_widget_rounded_rectangle"
            android:orientation="vertical"
            android:weightSum="1"
            tools:ignore="NestedWeights">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_weight="0.15" />

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_weight="0.7"
                android:importantForAccessibility="no"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:scaleType="fitCenter"
                android:src="@drawable/full_widget_preview_battery" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="@string/widget_preview_level"
            android:textColor="@color/widgetTextColor"
            android:textSize="40dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.5"
            android:orientation="vertical"
            tools:ignore="NestedWeights">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="0.5"
                android:gravity="center_horizontal|bottom"
                android:text="@string/widget_preview_duration"
                android:textColor="@color/widgetTextColor"
                android:textSize="20dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="0.5"
                android:gravity="center_horizontal|top"
                android:text="@string/activity_until_drained"
                android:textColor="@color/widgetTextColor"
                android:textSize="14dp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>

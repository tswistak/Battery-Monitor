<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/named_so_scroll_position_is_preserved"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent">

    <LinearLayout
        style="@style/help_ll"
        android:orientation="vertical">

        <View style="@style/help_cat_pre_margin" />

        <TextView
            style="@style/help_cat"
            android:text="@string/units_formatting_settings" />

        <TextView
            style="@style/help_text"
            android:text="@string/units_formatting_settings_help" />

        <View style="@style/help_cat_pre_margin" />

        <TextView
            style="@style/help_cat"
            android:text="@string/pref_cat_units" />

        <View style="@style/help_cat_post_margin" />

        <TextView
            style="@style/help_pref"
            android:text="@string/pref_temperature_unit" />

        <TextView
            style="@style/help_text"
            android:text="@string/pref_temperature_unit_help" />

        <View style="@style/help_cat_pre_margin" />

        <TextView
            style="@style/help_cat"
            android:text="@string/pref_cat_formatting" />

        <View style="@style/help_cat_post_margin" />

        <TextView
            style="@style/help_pref"
            android:text="@string/pref_long_duration_format" />

        <TextView
            style="@style/help_text"
            android:text="@string/pref_long_duration_format_help" />
    </LinearLayout>
</ScrollView>

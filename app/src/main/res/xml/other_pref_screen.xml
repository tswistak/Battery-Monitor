<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <PreferenceCategory
        app:key="change_app_language_holder"
        app:title="@string/pref_cat_language">
        <Preference
            app:key="change_app_language"
            app:singleLineTitle="false"
            app:title="@string/pref_change_app_language" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/pref_cat_autostart">
        <ListPreference
            android:defaultValue="auto"
            android:dialogTitle="@string/pref_autostart_at_boot_summary"
            android:entries="@array/boot_pref_entries"
            android:entryValues="@array/boot_pref_values"
            app:key="autostart"
            app:singleLineTitle="false"
            app:title="@string/pref_autostart_at_boot" />
    </PreferenceCategory>
</PreferenceScreen>

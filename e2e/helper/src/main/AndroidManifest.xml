<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <queries>
        <package android:name="codes.swistak.batterymonitor" />
    </queries>
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@android:drawable/ic_menu_info_details"
        android:label="Battery Monitor E2E widget host"
        android:theme="@android:style/Theme.Material.Light.NoActionBar"
        tools:targetApi="31">
        <activity
            android:name=".WidgetHostActivity"
            android:exported="true" />
    </application>

    <instrumentation
        android:name=".StorageProbe"
        android:functionalTest="true"
        android:targetPackage="codes.swistak.batterymonitor" />
    <instrumentation
        android:name=".WidgetProbe"
        android:functionalTest="true"
        android:targetPackage="codes.swistak.batterymonitor.e2ehelper" />
</manifest>

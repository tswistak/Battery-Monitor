---
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout
  title="Page not found"
  description="Find Battery Monitor downloads, help and source."
  pageId="not-found"
  path="/404/"
  noindex
>
  <div class="document-page">
    <h1>That page isn't here.</h1>
    <p class="page-lead">You can still find the app, get help or return to the homepage.</p>
    <div class="page-links">
      <a href="/">Home</a>
      <a href="/download/">Get the app</a>
      <a href="/help/">Help &amp; FAQ</a>
    </div>
  </div>
</SiteLayout>

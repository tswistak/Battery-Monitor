---
import SiteLayout from '../layouts/SiteLayout.astro';
import { getSiteConfig } from '../lib/site-config';
import { getPrivacySections } from '../content/en/privacy';
import { pageMeta } from '../content/en/ui';
const config = getSiteConfig();
const sections = getPrivacySections(config);
---

<SiteLayout {...pageMeta.privacy} pageId="privacy">
  <div class="document-page">
    <h1>Privacy Policy</h1>
    <p class="page-lead">
      This policy explains how the Battery Monitor Android app and this website handle your data and
      what choices you have.
    </p>
    <nav class="page-links" aria-label="Policy contents">
      {sections.map((section) => (
        <a href={'#' + section.id}>{section.title}</a>
      ))}
    </nav>
    {sections.map((section) => (
      <section id={section.id}>
        <h2>{section.title}</h2>
        <div class="prose" set:html={section.html} />
        {section.id === 'preferences' && (
          <>
            <button class="text-button" type="button" data-privacy-settings hidden>
              Privacy settings
            </button>
            <noscript>
              <p>Analytics stays off while JavaScript is disabled.</p>
            </noscript>
          </>
        )}
      </section>
    ))}
  </div>
</SiteLayout>

<style>
  .document-page :global(.privacy-facts) {
    margin-block: 1.25rem;
  }
  .document-page :global(.privacy-facts div + div) {
    margin-block-start: 0.75rem;
  }
  .document-page :global(.privacy-facts dt) {
    font-weight: 700;
  }
  .document-page :global(.privacy-facts dd) {
    margin-inline-start: 0;
  }
</style>

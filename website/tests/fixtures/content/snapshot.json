          "size": 833,
          "browser_download_url": "https://github.com/tswistak/Battery-Monitor/releases/download/1.7.1/battery-monitor-1.7.1.apk.asc",
          "digest": "sha256:fda5b7bafb8e9fad21eb30aeb6058678f0b122321207fa9e8721c842181f395b"
        }
      ]

          "size": 833,
          "browser_download_url": "https://github.com/tswistak/Battery-Monitor/releases/download/1.7.0/battery-monitor-1.7.0.apk.asc",
          "digest": "sha256:425755ec397505c84a07623f7ccedf3eb0ddd8faae86764480e10b222f9d87fe"
        }
      ]
